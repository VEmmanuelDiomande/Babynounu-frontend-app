# Mode de l'application: "dev" ou "prod"
VITE_MODE_APP=dev

# Clé de chiffrement (à générer aléatoirement, ne JAMAIS committer)
# Exemple de génération: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VITE_CRYPTO_KEY=

# URL optionnelle du backend (utile pour device/emulateur Android)
# IMPORTANT: utiliser l'IP de la machine qui héberge le backend (ex: ipconfig -> Adresse IPv4 Wi-Fi)
# NE PAS utiliser l'IP de la passerelle/routeur (ex: 192.168.8.1)
# VITE_API_BASE_URL=http://192.168.8.3:3000
