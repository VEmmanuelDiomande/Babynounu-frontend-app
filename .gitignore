# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate
$RECYCLE.BIN/


*.log
log.txt
npm-debug.log*
/resources
/android
/.idea
/.ionic
/.sass-cache
/.sourcemaps
/.versions
/.vscode/*
!/.vscode/extensions.json
/coverage
/dist
/node_modules
/platforms
/plugins
/www

# Vite local env overrides (ne pas committer)
.env*.local
# Fichiers d'environnement contenant des secrets (clé crypto, etc.)
.env
.env.development
.env.production


scripts/_tunnel.cjs
